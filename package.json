{
  "name": "decky-oled-tint",
  "version": "0.1.0",
  "description": "Decky plugin that corrects OLED green tint at low brightness using a per-brightness calibration curve.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests && tsc --noEmit -p . && rollup -c",
    "typecheck": "tsc --noEmit -p ."
  },
  "keywords": [
    "decky",
    "plugin",
    "oled",
    "color",
    "calibration"
  ],
  "author": "murdii",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
